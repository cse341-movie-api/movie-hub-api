  "definitions": {
    "Movie": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Back to the Future Part III"
        },
        "year": {
          "type": "number",
          "example": 1990
        },
        "plot": {
          "type": "string",
          "example": "Marty McFly travels to 1885 to rescue Doc Brown from a duel and fix the timeline."
        },
        "genres": {
          "type": "array",
          "example": [
            "Adventure",
            "Comedy",
            "Sci-Fi"
          ],
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "number",
          "example": 118
        },
        "rated": {
          "type": "string",
          "example": "PG"
        },
        "cast": {
          "type": "array",
          "example": [
            "Michael J. Fox",
            "Christopher Lloyd",
            "Mary Steenburgen"
          ],
          "items": {
            "type": "string"
          }
        },
        "poster": {
          "type": "string",
          "example": "https://m.media-amazon.com/images/M/MV5BOGI0NDFlYjUtYjc2Ny00MTE5LTg2OTEtZjU4NzVmNGE0YTMzXkEyXkFqcGdeQXVyNTAyODkwOQ@@._V1_SY1000_SX677_AL_.jpg"
        },
        "languages": {
          "type": "array",
          "example": [
            "English"
          ],
          "items": {
            "type": "string"
          }
        },
        "imdb": {
          "type": "object",
          "properties": {
            "rating": {
              "type": "number",
              "example": 7.4
            }
          }
        },
        "rotten_tomatoes": {
          "type": "object",
          "properties": {
            "tomato_meter": {
              "type": "number",
              "example": 79
            }
          }
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "googleId": {
          "type": "string",
          "example": "109876543210987654321"
        },
        "displayName": {
          "type": "string",
          "example": "Robert Forrester"
        },
        "email": {
          "type": "string",
          "example": "rforrester@example.com"
        },
        "joinedDate": {
          "type": "string",
          "example": "2026-06-24T20:08:49.058Z"
        },
        "role": {
          "type": "string",
          "example": "user"
        },
        "location": {
          "type": "string",
          "example": "Seattle, WA"
        },
        "preferences": {
          "type": "object",
          "properties": {
            "favoriteGenre": {
              "type": "string",
              "example": "Sci-Fi"
            },
            "notifications": {
              "type": "boolean",
              "example": true
            }
          }
        }
      }
    },
    "Watchlist": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "665f8a1b2c3d4e5f6a7b8c9d"
        },
        "movieId": {
          "type": "string",
          "example": "6a2202b14be80c66150f5454"
        },
        "dateAdded": {
          "type": "string",
          "example": "2026-06-04T15:00:00Z"
        },
        "status": {
          "type": "string",
          "example": "completed"
        },
        "priority": {
          "type": "string",
          "example": "low"
        },
        "reminderSet": {
          "type": "boolean",
          "example": false
        },
        "notes": {
          "type": "string",
          "example": "Movie night completely finished."
        }
      }
    },
    "Review": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "665f8a1b2c3d4e5f6a7b8c9d"
        },
        "movieId": {
          "type": "string",
          "example": "573a1397f29313caabce8783"
        },
        "rating": {
          "type": "number",
          "example": 5
        },
