  "preferences": {
    "favoriteGenre": "Sci-Fi",
    "notifications": false
  }
}

### DELETE A USER
DELETE {{localBaseUrl}}/users/665f8a1b2c3d4e5f6a7b8c9d


# ==========================================
# REVIEWS
# ==========================================

### CREATE A NEW CUSTOM USER REVIEW
POST {{localBaseUrl}}/reviews
Content-Type: application/json

{
  "userId": "665f8a1b2c3d4e5f6a7b8c9d",
  "movieId": "6a2202b14be80c66150f5454",
  "rating": 5,
  "reviewText": "An absolute classic! The storytelling is top-tier.",
  "authorName": "Jane Doe",
  "isSpoiler": false
}

### READ ALL SYSTEM REVIEWS
GET {{localBaseUrl}}/reviews

### READ SINGLE REVIEW BY ID
GET {{localBaseUrl}}/reviews/665f8a2a2c3d4e5f6a7b8c9e

### READ REVIEWS FOR A SPECIFIC MOVIE (Relational Filter Route)
GET {{localBaseUrl}}/reviews/movie/6a2202b14be80c66150f5454

### READ REVIEWS WRITTEN BY A SPECIFIC USER (Relational Filter Route)
GET {{localBaseUrl}}/reviews/user/665f8a1b2c3d4e5f6a7b8c9d

### UPDATE A REVIEWS ENTRY
PUT {{localBaseUrl}}/reviews/665f8a2a2c3d4e5f6a7b8c9e
Content-Type: application/json

{
  "userId": "665f8a1b2c3d4e5f6a7b8c9d",
  "movieId": "6a2202b14be80c66150f5454",
  "rating": 4,
  "reviewText": "Still fantastic upon rewatch, though some of the family paradox choices raise funny questions.",
  "authorName": "Jane Doe",
  "isSpoiler": false
}

### DELETE A REVIEW
DELETE {{localBaseUrl}}/reviews/665f8a2a2c3d4e5f6a7b8c9e


# ==========================================
# WATCHLISTS
# ==========================================

### CREATE A WATCHLIST ENTRY
POST {{localBaseUrl}}/watchlist
Content-Type: application/json

{
  "userId": "665f8a1b2c3d4e5f6a7b8c9d",
  "movieId": "6a2202b14be80c66150f5454",
  "dateAdded": "2026-06-04T15:00:00Z",
  "status": "planned",
  "priority": "high",
  "reminderSet": true,
  "notes": "Looking forward to re-watching this one."
}

### READ GLOBAL SYSTEM WATCHLISTS
GET {{localBaseUrl}}/watchlist

### READ SINGLE WATCHLIST ENTRY BY ID
GET {{localBaseUrl}}/watchlist/665f8a3c2c3d4e5f6a7b8c9f

### READ WATCHLIST FOR A SPECIFIC USER (Relational Filter Route)
GET {{localBaseUrl}}/watchlist/user/665f8a1b2c3d4e5f6a7b8c9d

### UPDATE A WATCHLIST ENTRY
PUT {{localBaseUrl}}/watchlist/665f8a3c2c3d4e5f6a7b8c9f
Content-Type: application/json

{
  "userId": "665f8a1b2c3d4e5f6a7b8c9d",
  "movieId": "6a2202b14be80c66150f5454",
  "dateAdded": "2026-06-04T15:00:00Z",
  "status": "completed",
  "priority": "low",
  "reminderSet": false,
  "notes": "Movie night completely finished."
}

### DELETE A WATCHLIST ENTRY
DELETE {{localBaseUrl}}/watchlist/665f8a3c2c3d4e5f6a7b8c9f