# ==========================================
# USERS
# ==========================================

### CREATE A NEW USER
POST {{localBaseUrl}}/users
Content-Type: application/json

{
  "googleId": "109876543210987654321",
  "displayName": "Jane Doe",
  "email": "jane.doe@example.com",
  "joinedDate": "2026-06-04T12:00:00Z",
  "role": "user",
  "location": "Rexburg, ID",
  "preferences": {
    "favoriteGenre": "Sci-Fi",
    "notifications": true
  }
}

### READ ALL USERS
GET {{localBaseUrl}}/users

### READ SINGLE USER BY ID
GET {{localBaseUrl}}/users/665f8a1b2c3d4e5f6a7b8c9d

### READ SINGLE USER BY EMAIL (Relational Lookup Route)
GET {{localBaseUrl}}/users/email/jane.doe@example.com

### UPDATE A USER
PUT {{localBaseUrl}}/users/665f8a1b2c3d4e5f6a7b8c9d
Content-Type: application/json

{
  "googleId": "109876543210987654321",
  "displayName": "Jane Doe",
  "email": "jane.doe@example.com",
  "joinedDate": "2026-06-04T12:00:00Z",
  "role": "user",
