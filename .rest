# ==========================================
# MOVIES
# ==========================================

### CREATE A NEW MOVIE (Mission: Impossible)
POST {{localBaseUrl}}/movies
Content-Type: application/json

{
  "title": "Mission: Impossible",
  "year": 1996,
  "plot": "An American secret agent, falsely accused of disloyalty, must discover and expose the real spy without the help of his organization.",
  "genres": ["Action", "Adventure", "Thriller"],
  "runtime": 110,
  "rated": "PG-13",
  "cast": ["Tom Cruise", "Jon Voight", "Emmanuelle Béart"],
  "poster": "https://m.media-amazon.com/images/M/MV5BMTc3NjI2OTA1N15BMl5BanBnXkFtZTgwNzM3MTM5MTE@._V1_SY1000_SX677_AL_.jpg",
  "languages": ["English", "French"],
  "imdb": {
    "rating": 7.1
  },
  "rotten_tomatoes": {
    "tomato_meter": 67
  }
